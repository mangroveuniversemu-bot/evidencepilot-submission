# Copy to .env for local runs. Never commit .env.
# Deterministic verification needs none of these; they are only used by
# `python -m app.main agent ...`, which calls Amazon Bedrock.

AWS_REGION=us-west-2
EVIDENCEPILOT_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Credentials come from the standard AWS chain (SSO profile, instance role,
# or environment). Do not put secrets in this file.
